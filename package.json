{
  "name": "markrun",
  "version": "0.1.0",
  "private": true,
  "description": "Run Markdown files as commands: TypeScript blocks are code, sections are templates.",
  "keywords": [
    "markdown",
    "cli",
    "bun",
    "typescript",
    "templates",
    "literate-programming",
    "claude-code",
    "hooks"
  ],
  "author": "pyronaur",
  "homepage": "https://github.com/pyronaur/markrun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyronaur/markrun.git"
  },
  "bugs": "https://github.com/pyronaur/markrun/issues",
  "type": "module",
  "bin": {
    "mr": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:node": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "bun build ./src/cli.ts --compile --bytecode --no-compile-autoload-bunfig --outfile ./dist/mr",
    "mr": "bun ./src/cli.ts"
  },
  "dependencies": {
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "24.0.4"
  },
  "license": "MIT"
}
